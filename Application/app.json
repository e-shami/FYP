{
  "expo": {
    "name": "Tankerwala",
    "slug": "tankerwala-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/notificationIcon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to display on your profile."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notificationIcon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "splash": {
      "image": "./assets/logo_sp.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/4e16e664-c758-4549-85de-35a5af821248"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/notificationIcon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.lunatech.CityGo"
    },
    "android": {
      "icon": "./assets/notificationIcon.png",
      "package": "com.lunatech.CityGo",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "@env_GOOGLE_MAP_API_KEY"
        }
      },
      "useNextNotificationsApi": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4e16e664-c758-4549-85de-35a5af821248"
      }
    },
    "owner": "shami169",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
